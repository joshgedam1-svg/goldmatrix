# Disable directory browsing
Options -Indexes

<IfModule mod_rewrite.c>
    RewriteEngine On

    # 1. Block direct web access to sensitive internal directories
    RewriteRule ^(app|config|database|storage|routes|views|scratch|includes)(/.*)?$ - [F,L,NC]

    # 2. Block direct web access to sensitive environment and backup files
    RewriteRule \.(env|sqlite|sql|log|lock|bak|yml|yaml)$ - [F,L,NC]
    RewriteRule (^|/)\.(?!well-known) - [F,L]

    # 3. Direct rewrite for assets and uploads to public directory
    RewriteCond %{REQUEST_URI} !^/public/
    RewriteRule ^assets/(.*)$ public/assets/$1 [L]
    RewriteRule ^uploads/(.*)$ public/uploads/$1 [L]
    RewriteRule ^favicon\.ico$ public/favicon.ico [L]
    RewriteRule ^robots\.txt$ public/robots.txt [L]

    # 4. Route all application requests to public/index.php
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^(.*)$ public/index.php [L,QSA]
</IfModule>
