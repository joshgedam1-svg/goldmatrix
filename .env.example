# ============================================================
# GoldMatrix ERP - Admin CMS Environment Configuration
# ============================================================

APP_NAME="GoldMatrix ERP"
APP_URL=http://localhost:8085
APP_ENV=production
APP_DEBUG=false
APP_TIMEZONE=Asia/Kolkata
APP_LOCALE=en

# ---- Database ----
DB_HOST=localhost
DB_PORT=3306
DB_NAME=jewelry_erp_cms
DB_USER=root
DB_PASS=
DB_CHARSET=utf8mb4

# ---- Session ----
SESSION_LIFETIME=7200
SESSION_NAME=jewelry_erp_session

# ---- Security ----
APP_KEY=change_this_to_random_32_char_string_123456
CSRF_TOKEN_EXPIRY=3600

# ---- Upload ----
UPLOAD_MAX_SIZE=10485760
UPLOAD_PATH=storage/uploads
ALLOWED_IMAGE_TYPES=jpg,jpeg,png,webp,avif,svg,pdf

# ---- Mail (optional) ----
MAIL_HOST=smtp.mailtrap.io
MAIL_PORT=2525
MAIL_USER=
MAIL_PASS=
MAIL_FROM=noreply@goldmatrixerp.com
MAIL_FROM_NAME="GoldMatrix ERP"

# ---- Cache ----
CACHE_DRIVER=file
CACHE_PATH=storage/cache
CACHE_TTL=3600

# ---- Logs ----
LOG_PATH=storage/logs
LOG_LEVEL=info
